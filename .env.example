# Mandatory
ENCRYPTION_KEY= YOUR ENCRYPTION KEY
# Secret key for JWT API authentication
JWT_SECRET_KEY= YOUR JWT SECRET

# [Optional] Compose already has this default values.
# DB_HOST=pgwarden_db
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=postgres

# [Optional] API Port config. The web UI is served by the api on this same
# port (the SPA is baked into the api image), so this is the only host port
# you usually need to think about.
# API_PORT=8080